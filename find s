# FIND-S Algorithm Implementation

import pandas as pd

# Training Data
data = [
    ['Sunny', 'Warm', 'Normal', 'Strong', 'Warm', 'Same', 'Yes'],
    ['Sunny', 'Warm', 'High', 'Strong', 'Warm', 'Same', 'Yes'],
    ['Rainy', 'Cold', 'High', 'Strong', 'Warm', 'Change', 'No'],
    ['Sunny', 'Warm', 'High', 'Strong', 'Cool', 'Change', 'Yes']
]

# Create DataFrame
columns = ['Sky', 'AirTemp', 'Humidity', 'Wind', 'Water', 'Forecast', 'EnjoySport']
df = pd.DataFrame(data, columns=columns)

print("Training Data:\n")
print(df)

# FIND-S Algorithm
concepts = df.iloc[:, :-1].values
target = df.iloc[:, -1].values

# Initialize hypothesis with first positive example
hypothesis = concepts[0].copy()

print("\nInitial Hypothesis:")
print(hypothesis)

# Update hypothesis
for i in range(len(concepts)):
    if target[i] == "Yes":
        for j in range(len(hypothesis)):
            if hypothesis[j] != concepts[i][j]:
                hypothesis[j] = '?'
    
    print(f"\nHypothesis after Example {i+1}:")
    print(hypothesis)

print("\nFinal Most Specific Hypothesis:")
print(hypothesis)
